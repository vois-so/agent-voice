{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/agent-voice.mjs",
              "hook",
              "claude",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/agent-voice.mjs",
              "hook",
              "claude",
              "notify"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
